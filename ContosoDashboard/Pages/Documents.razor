@page "/documents"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ContosoDashboard.Models
@using ContosoDashboard.Services
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Documents - ContosoDashboard</PageTitle>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4"><h1>Documents</h1><button class="btn btn-primary" @onclick="ShowUpload">Upload documents</button></div>
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div> }
    <div class="card mb-4"><div class="card-body"><div class="row g-2"><div class="col-md-4"><label class="form-label">Search</label><input class="form-control" @bind="query.Search" @bind:event="oninput" /></div><div class="col-md-3"><label class="form-label">Category</label><select class="form-select" @bind="query.Category"><option value="">All categories</option>@foreach (var category in DocumentValidation.Categories) { <option value="@category">@category</option> }</select></div><div class="col-md-2 align-self-end"><button class="btn btn-outline-secondary" @onclick="LoadDocuments">Search</button></div></div></div></div>
    @if (showUpload) {
        <div class="card mb-4"><div class="card-body"><h2 class="h4">Upload documents</h2><div class="row g-2"><div class="col-md-4"><label class="form-label">Title</label><input class="form-control" @bind="title" /></div><div class="col-md-3"><label class="form-label">Category</label><select class="form-select" @bind="category">@foreach (var item in DocumentValidation.Categories) { <option value="@item">@item</option> }</select></div><div class="col-md-5"><label class="form-label">Description</label><input class="form-control" @bind="description" /></div><div class="col-md-6"><label class="form-label">Tags</label><input class="form-control" @bind="tags" /></div><div class="col-md-6"><label class="form-label">Project</label><select class="form-select" @bind="projectId"><option value="">Personal document</option>@foreach (var project in projects) { <option value="@project.ProjectId">@project.Name</option> }</select></div><div class="col-12"><InputFile @key="inputKey" OnChange="SelectFiles" multiple /></div></div><div class="mt-3"><button class="btn btn-primary" disabled="@(selectedFiles.Count == 0 || isUploading)" @onclick="Upload">@(isUploading ? "Uploading..." : "Upload")</button> <button class="btn btn-link" @onclick="HideUpload">Cancel</button></div>@if (uploadResults.Count > 0) { <ul class="mt-3">@foreach (var result in uploadResults) { <li class="@(result.Success ? "text-success" : "text-danger")">@result.FileName: @(result.Success ? "Uploaded" : result.Error)</li> }</ul> }</div></div>
    }
    @if (documents == null) { <p><em>Loading...</em></p> } else if (documents.Count == 0) { <div class="alert alert-info">No accessible documents found.</div> } else { <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Title</th><th>Category</th><th>Project</th><th>Uploaded</th><th>Size</th><th>Actions</th></tr></thead><tbody>@foreach (var document in documents) { <tr><td><strong>@document.Title</strong><br /><small class="text-muted">@document.OriginalFileName</small></td><td>@document.Category</td><td>@(document.Project?.Name ?? "Personal")</td><td>@document.UploadedDate.ToLocalTime().ToString("g")</td><td>@FormatSize(document.FileSize)</td><td><a class="btn btn-sm btn-outline-primary" href="/documents/download/@document.DocumentId">Download</a>@if (document.FileType is "application/pdf" or "image/jpeg" or "image/png") { <a class="btn btn-sm btn-outline-secondary ms-1" target="_blank" href="/documents/preview/@document.DocumentId">Preview</a> }</td></tr> }</tbody></table></div>}
</div>
@code {
    private List<Document>? documents; private List<Project> projects = new(); private List<IBrowserFile> selectedFiles = new(); private List<DocumentUploadResult> uploadResults = new(); private DocumentQuery query = new(); private string title = "", category = "Personal Files", description = "", tags = "", message = ""; private int? projectId; private int userId; private bool showUpload, isUploading, isError; private Guid inputKey = Guid.NewGuid();
    protected override async Task OnInitializedAsync() { var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var claim = state.User.FindFirst(ClaimTypes.NameIdentifier); int.TryParse(claim?.Value, out userId); projects = await ProjectService.GetUserProjectsAsync(userId); await LoadDocuments(); }
    private async Task LoadDocuments() { documents = await DocumentService.SearchAsync(userId, query); }
    private void ShowUpload() => showUpload = true; private void HideUpload() => showUpload = false; private void SelectFiles(InputFileChangeEventArgs args) => selectedFiles = args.GetMultipleFiles(20).ToList();
    private async Task Upload() { isUploading = true; message = ""; isError = false; uploadResults.Clear(); var requests = new List<DocumentUploadRequest>(); foreach (var file in selectedFiles) { try { var stream = new MemoryStream(); await using var source = file.OpenReadStream(DocumentValidation.MaxFileSize); await source.CopyToAsync(stream); stream.Position = 0; requests.Add(new DocumentUploadRequest { Title = title, Description = description, Category = category, Tags = tags, ProjectId = projectId, OriginalFileName = file.Name, ContentType = file.ContentType, FileSize = file.Size, Content = stream }); } catch { uploadResults.Add(new DocumentUploadResult { FileName = file.Name, Error = "The file could not be read." }); } } uploadResults.AddRange(await DocumentService.UploadAsync(userId, requests)); foreach (var request in requests) request.Content.Dispose(); selectedFiles.Clear(); inputKey = Guid.NewGuid(); isUploading = false; isError = uploadResults.Any(result => !result.Success); message = isError ? "Some files were rejected." : "Documents uploaded successfully."; await LoadDocuments(); }
    private static string FormatSize(long bytes) => bytes < 1024 ? $"{bytes} B" : bytes < 1024 * 1024 ? $"{bytes / 1024d:0.0} KB" : $"{bytes / 1024d / 1024d:0.0} MB";
}
