@page "/documents/reports"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using ContosoDashboard.Models
@using ContosoDashboard.Services
@attribute [Authorize(Roles = "Administrator")]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Document Reports - ContosoDashboard</PageTitle>
<div class="container-fluid">
    <h1>Document Reports</h1>
    @if (report == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row g-4">
            <div class="col-md-4"><div class="card"><div class="card-header">File types</div><ul class="list-group list-group-flush">@foreach (var item in report.Types) { <li class="list-group-item d-flex justify-content-between"><span>@item.FileType</span><strong>@item.Count</strong></li> }</ul></div></div>
            <div class="col-md-4"><div class="card"><div class="card-header">Most active uploaders</div><ul class="list-group list-group-flush">@foreach (var item in report.Uploaders) { <li class="list-group-item d-flex justify-content-between"><span>@item.UserName</span><strong>@item.Count</strong></li> }</ul></div></div>
            <div class="col-md-4"><div class="card"><div class="card-header">Access patterns</div><ul class="list-group list-group-flush">@foreach (var item in report.AccessPatterns) { <li class="list-group-item d-flex justify-content-between"><span>@item.Action</span><strong>@item.Count</strong></li> }</ul></div></div>
        </div>
    }
</div>
@code {
    private DocumentReport? report;
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst(ClaimTypes.NameIdentifier);
        if (int.TryParse(claim?.Value, out var userId)) report = await DocumentService.GetReportAsync(userId);
    }
}
